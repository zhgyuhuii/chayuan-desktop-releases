{
  "version": "1.0.0",
  "source": "bundled",
  "note": "察元内置工具目录；可通过 CHAYUAN_ROOT/tools_catalog.override.json 覆盖/补充。",
  "categories": {
    "rag": "检索增强 (RAG)",
    "web": "网络与信息获取",
    "math": "数学与计算",
    "media": "多模态生成",
    "data": "数据 / 运维 / BI",
    "location": "位置与地图",
    "code": "代码与研发协作",
    "message": "消息推送",
    "integration": "企业知识 / 协作集成",
    "system": "系统"
  },
  "tools": [
    {
      "key": "search_local_knowledgebase",
      "title": "本地知识库检索",
      "icon": "library_books",
      "category": "rag",
      "summary": "基于向量库的本地知识检索 RAG",
      "description": "从察元已建好的本地知识库中，根据用户问题做语义检索，Top-K 文档会被拼入 Prompt 一起交给 LLM，兼顾答案准确性与可追溯来源。适合：企业私域文档问答、产品手册问答、规范性资料查询。",
      "tags": ["检索", "RAG", "本地", "知识库", "langchain"],
      "docs_url": "",
      "fields": [
        {"path": "top_k", "label": "召回数量 top_k", "widget": "number", "min": 1, "max": 50, "step": 1, "default": 3, "help": "每次检索返回的相关片段数量，越大召回越全但噪声也多。"},
        {"path": "score_threshold", "label": "相似度阈值", "widget": "number", "min": 0.0, "max": 2.0, "step": 0.05, "default": 2.0, "help": "小于此相似度的文档会被过滤掉（距离度量，越小越相似）。"},
        {"path": "conclude_prompt.with_result", "label": "命中时 Prompt 模板", "widget": "textarea", "help": "使用 jinja2 语法：{{ context }} / {{ question }}。"},
        {"path": "conclude_prompt.without_result", "label": "未命中时 Prompt 模板", "widget": "textarea", "help": "检索未命中时使用的提示词。"}
      ],
      "defaults": {
        "use": false,
        "top_k": 3,
        "score_threshold": 2.0,
        "conclude_prompt": {
          "with_result": "<指令>根据已知信息，简洁和专业的来回答问题。如果无法从中得到答案，请说 \"根据已知信息无法回答该问题\"，不允许在答案中添加编造成分，答案请使用中文。</指令>\n<已知信息>{{ context }}</已知信息>\n<问题>{{ question }}</问题>\n",
          "without_result": "请你根据我的提问回答我的问题:\n{{ question }}\n请注意，你必须在回答结束后强调，你的回答是根据你的经验回答而不是参考资料回答的。\n"
        }
      }
    },
    {
      "key": "search_internet",
      "title": "联网搜索",
      "icon": "travel_explore",
      "category": "web",
      "summary": "Bing / DuckDuckGo / Tavily / Serper / SearxNG / Metaphor",
      "description": "调用主流公共搜索引擎做互联网检索，再把摘要拼入 Prompt。推荐配置：国内自建走 SearxNG；需要英文高质量结果用 Serper（Google）；做 AI 原生摘要用 Tavily（LangChain 官方主推）。核心价值：弥补大模型的知识时效性短板。",
      "tags": ["搜索", "网络", "Bing", "Tavily", "Serper", "langchain"],
      "docs_url": "https://python.langchain.com/docs/integrations/tools/",
      "fields": [
        {"path": "search_engine_name", "label": "搜索引擎", "widget": "select", "choices": ["bing", "duckduckgo", "tavily", "serper", "metaphor", "searx"], "default": "duckduckgo"},
        {"path": "top_k", "label": "召回数量 top_k", "widget": "number", "min": 1, "max": 50, "step": 1, "default": 5},
        {"path": "search_engine_config.bing.bing_search_url", "label": "Bing API URL", "widget": "text", "placeholder": "https://api.bing.microsoft.com/v7.0/search"},
        {"path": "search_engine_config.bing.bing_key", "label": "Bing API Key", "widget": "password"},
        {"path": "search_engine_config.tavily.api_key", "label": "Tavily API Key", "widget": "password", "help": "在 https://tavily.com 免费注册获取"},
        {"path": "search_engine_config.tavily.search_depth", "label": "Tavily 深度", "widget": "select", "choices": ["basic", "advanced"], "default": "basic"},
        {"path": "search_engine_config.serper.api_key", "label": "Serper API Key", "widget": "password", "help": "在 https://serper.dev 免费注册获取 Google Search 代理 Key"},
        {"path": "search_engine_config.serper.hl", "label": "Serper 语言", "widget": "text", "placeholder": "zh-cn"},
        {"path": "search_engine_config.serper.gl", "label": "Serper 地区", "widget": "text", "placeholder": "us"},
        {"path": "search_engine_config.metaphor.metaphor_api_key", "label": "Metaphor Key", "widget": "password"},
        {"path": "search_engine_config.searx.host", "label": "SearxNG host", "widget": "text", "placeholder": "https://metasearx.com"},
        {"path": "search_engine_config.searx.language", "label": "SearxNG 语言", "widget": "text", "placeholder": "zh-CN"},
        {"path": "conclude_prompt", "label": "结果汇总 Prompt", "widget": "textarea", "help": "把联网搜索结果拼给 LLM 的模板，使用 jinja2：{{ context }} / {{ question }}。"}
      ],
      "defaults": {
        "use": false,
        "search_engine_name": "duckduckgo",
        "search_engine_config": {
          "bing": {"bing_search_url": "https://api.bing.microsoft.com/v7.0/search", "bing_key": ""},
          "duckduckgo": {},
          "tavily": {"api_key": "", "search_depth": "basic", "include_answer": false, "include_raw_content": false},
          "serper": {"api_key": "", "gl": "us", "hl": "zh-cn", "type": "search"},
          "metaphor": {"metaphor_api_key": "", "split_result": false, "chunk_size": 500, "chunk_overlap": 0},
          "searx": {"host": "https://metasearx.com", "engines": [], "categories": [], "language": "zh-CN"}
        },
        "top_k": 5,
        "conclude_prompt": "<指令>这是搜索到的互联网信息，请你根据这些信息进行提取并有调理，简洁的回答问题。如果无法从中得到答案，请说 \"无法搜索到能回答问题的内容\"。</指令>\n<已知信息>{{ context }}</已知信息>\n<问题>\n{{ question }}\n</问题>\n"
      }
    },
    {
