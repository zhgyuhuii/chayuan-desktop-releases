    {
      "key": "text2sql",
      "title": "自然语言转 SQL",
      "icon": "storage",
      "category": "data",
      "summary": "把用户问题翻译为 SQL 并查库",
      "description": "LLM 读取库表结构后，把用户自然语言转为 SQL 并执行返回结果。生产环境建议：① 连从库；② 打开 read_only；③ 配置 table_comments 帮 LLM 理解语义；④ 慢查询限制。",
      "tags": ["数据库", "SQL", "BI"],
      "docs_url": "",
      "fields": [
        {"path": "model_name", "label": "使用的 LLM", "widget": "text", "help": "建议填写 model_settings.yaml 中 llm_models 里的名称。"},
        {"path": "sqlalchemy_connect_str", "label": "数据库 URI", "widget": "text", "placeholder": "mysql+pymysql://user:pass@host:port/db"},
        {"path": "read_only", "label": "只读模式", "widget": "switch", "help": "开启后 LLM 生成的 SQL 仅允许 SELECT，强烈推荐生产打开。"},
        {"path": "top_k", "label": "最多返回行数", "widget": "number", "min": 1, "max": 500, "step": 1, "default": 50},
        {"path": "return_intermediate_steps", "label": "返回中间步骤", "widget": "switch"}
      ],
      "defaults": {
        "use": false,
        "model_name": "qwen-plus",
        "sqlalchemy_connect_str": "mysql+pymysql://user:pass@host:port/db",
        "read_only": true,
        "top_k": 50,
        "return_intermediate_steps": true,
        "table_names": [],
        "table_comments": {}
      }
    },
