        {"path": "max_bytes", "label": "响应截断字节数", "widget": "number", "min": 1024, "max": 2000000, "step": 1024, "default": 200000, "help": "超出部分会被截断，避免把 MB 级响应全部喂给 LLM。"},
        {"path": "default_headers.User-Agent", "label": "默认 User-Agent", "widget": "text", "placeholder": "chayuan-agent/1.0"}
      ],
      "defaults": {
        "use": false,
        "allowlist": [],
