# 构建上下文排除项 —— 只有实际要进镜像的文件才应该进 build context
# 这不仅加快了 COPY 速度，也避免把本机临时产物（比如 local .venv / Streamlit
# 状态目录）带进 builder 阶段，破坏 `poetry install` 的 venv。

.git
.gitignore
.gitattributes

# ---- Python 运行产物 ----
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# ---- venv / egg-info ----
**/.venv/
**/venv/
**/*.egg-info/

# ---- IDE / OS ----
**/.DS_Store
**/.idea/
**/.vscode/

# ---- 本地数据（绝对不要进镜像） ----
chayuan_data/
chayuan_data_*/
chatchat_data_*/
**/terminals/

# ---- 构建产物 ----
dist/
build/

# ---- docker 自身 ----
docker/prod/.env
docker/prod/certs/
