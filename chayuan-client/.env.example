# ─────────────────────────────────────────────────────────────
# 察元 AI 客户端 · 环境变量样例
# 复制为 .env.local（apps/desktop/.env.local 与 apps/web/.env.local）
# ─────────────────────────────────────────────────────────────

# 后端 chayuan-server FastAPI
VITE_API_BASE=http://127.0.0.1:62581

# Langfuse self-host
VITE_LF_HOST=http://127.0.0.1:3000
VITE_LF_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_LF_PROJECT_ID=cmxxxxxxxxxxxxxxxxxxxxxx

# 应用
VITE_APP_NAME=察元 AI 助手
VITE_APP_VERSION=0.1.0

# 是否上传遥测（用户也可在设置中关闭）
VITE_TELEMETRY_DEFAULT=true

# Web 部署专用：
#   留空 → 同源 /api 反代（推荐，配 nginx）
#   填   http://host:62581 → 直连（要求后端 OPEN_CROSS_DOMAIN=true）
VITE_WEB_API_BASE=
