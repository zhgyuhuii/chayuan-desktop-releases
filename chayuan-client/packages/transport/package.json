{
  "name": "@chayuan/transport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "types": "./src/sse-worker.ts",
      "default": "./src/sse-worker.ts"
    }
