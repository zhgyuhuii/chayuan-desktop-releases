{
  "name": "@chayuan/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "chromatic": "chromatic --exit-zero-on-changes --build-script-name=storybook:build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@chayuan/api": "workspace:*",
    "@chayuan/i18n": "workspace:*",
    "@chayuan/observability": "workspace:*",
    "@chayuan/platform-shared": "workspace:*",
    "@chayuan/transport": "workspace:*",
    "@chayuan/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.85.0",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "ai": "^4.0.20",
    "dompurify": "^3.2.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "marked": "^15.0.4",
    "opencc-js": "^1.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reactflow": "^11.11.4",
    "shiki": "^1.24.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "chromatic": "^11.20.2",
    "storybook": "^8.4.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
