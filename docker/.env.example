# 察元 AI Docker — 环境变量配置样例
# ====================================================================
# 用法:
#   cp .env.example .env
#   编辑 .env 填自己的密钥/密码
#   docker compose up -d --build
#
# .env 由 docker compose 自动读取,覆盖 docker-compose.yaml 里同名 env。
# .env 已加进 .gitignore,绝不会进 git。
# ====================================================================


# ── 模式 1: 单机匿名 (default, 装完即用,无需登录) ────────────────
# 任何浏览器/客户端都能直接进,所有数据共享一个 GUEST 账号。
# 适合: 个人 / 内网开发 / 本地评估。
#
# 不需要任何配置 — docker-compose.yaml 默认就是这个模式。


# ── 模式 2: 多用户 + 登录 (生产/团队部署) ──────────────────────────
# 取消下面注释,docker compose up -d 重启即生效。
# 启用后:
#   - /chat/* /knowledge_base/* /api/* 全部需要 JWT
#   - /auth/login 用 username + password 换 token
#   - 前端会自动弹登录框
#
# CHAYUAN_AUTH_REQUIRED=true
# CHAYUAN_ALLOW_REGISTRATION=false              # 内部部署关注册更安全
# JWT_SECRET=                                   # ← 生成: openssl rand -hex 64
# AUTH_DEFAULT_ADMIN_USERNAME=admin
# AUTH_DEFAULT_ADMIN_PASSWORD=                  # ← 留空 = 首次启动随机生成,看日志


# ── 高级 ─────────────────────────────────────────────────────────
# 端口冲突时改宿主映射(冒号左边),容器内端口写死不动。
# 在 .env 里写:
# CHAYUAN_WEB_PORT=9090         # 前端端口 (默认 8080)
# CHAYUAN_API_PORT=62581        # API 端口
# CHAYUAN_CFGPANEL_PORT=8502    # 配置面板端口
# 然后改 docker-compose.yaml 里 ports 引用变量(${CHAYUAN_WEB_PORT}:80)


# ── 可观测 (默认全关) ────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
